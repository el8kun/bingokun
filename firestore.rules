rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /admin/{docId} {
      // Lecture autorisée pour que les corrections soient appliquées dans le jeu.
      // Écriture réservée au compte admin.
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /rooms/{roomCode} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /participants/{userId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.auth.uid == userId
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == "waiting";

        allow update: if signedIn()
          && request.auth.uid == userId;

        allow delete: if signedIn()
          && (request.auth.uid == userId || isAdmin());
      }
    }

    match /results/{resultId} {
      allow read: if true;

      allow create, update: if signedIn()
        && request.resource.data.playerUid == request.auth.uid;

      allow delete: if isAdmin();
    }
  }
}
